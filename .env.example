# Copy a bootstrapped template (recommended — includes a Clerk publishable key shape so builds work):
#   cp env.local.template .env.local
# Or copy this file instead:
#   cp .env.example .env.local
#
# --- Clerk (required) — https://dashboard.clerk.com → your app → API Keys ---
# Use the Publishable key and Secret from the SAME application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional if Clerk returns host_invalid — use exact Frontend API URL from Dashboard → Domains
# NEXT_PUBLIC_CLERK_FAPI=https://YOUR_INSTANCE.clerk.accounts.dev

# --- Groq (required for AI) — https://console.groq.com/keys ---
GROQ_API_KEY=
# Optional:
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Supabase (optional) — Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
